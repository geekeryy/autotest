{
  "basePath": "/",
  "consumes": [
    "application/json"
  ],
  "definitions": {
    "AdminLoginRequest": {
      "properties": {
        "password": {
          "description": "管理员登录密码",
          "example": "admin123",
          "type": "string"
        },
        "username": {
          "description": "管理员登录用户名",
          "example": "admin-root",
          "type": "string"
        }
      },
      "required": [
        "username",
        "password"
      ],
      "type": "object"
    },
    "AdminStats": {
      "properties": {
        "activeUsers": {
          "description": "活跃用户数",
          "example": 2,
          "type": "integer"
        },
        "adminUsers": {
          "description": "管理员用户数",
          "example": 1,
          "type": "integer"
        },
        "generatedAt": {
          "description": "统计数据生成时间",
          "example": "2026-01-01T00:00:00Z",
          "format": "date-time",
          "type": "string"
        },
        "totalUsers": {
          "description": "用户总数",
          "example": 2,
          "type": "integer"
        }
      },
      "required": [
        "totalUsers",
        "activeUsers",
        "adminUsers",
        "generatedAt"
      ],
      "type": "object"
    },
    "AdminUserListResponse": {
      "properties": {
        "total": {
          "description": "符合条件的用户总数",
          "example": 2,
          "type": "integer"
        },
        "users": {
          "description": "用户列表",
          "items": {
            "$ref": "#/definitions/User"
          },
          "type": "array"
        }
      },
      "required": [
        "total",
        "users"
      ],
      "type": "object"
    },
    "AuditLog": {
      "properties": {
        "action": {
          "description": "操作类型，如 import.swagger、run.suite、report.created",
          "example": "run.suite",
          "type": "string"
        },
        "actor": {
          "description": "操作人用户名",
          "example": "admin-root",
          "type": "string"
        },
        "createdAt": {
          "description": "操作时间",
          "example": "2026-01-01T00:00:00Z",
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "description": "审计日志唯一标识",
          "example": "audit-1",
          "type": "string"
        },
        "resource": {
          "description": "操作对象，格式为 类型:名称",
          "example": "suite:regression",
          "type": "string"
        }
      },
      "required": [
        "id",
        "actor",
        "action",
        "resource",
        "createdAt"
      ],
      "type": "object"
    },
    "AuthUser": {
      "properties": {
        "id": {
          "description": "用户唯一标识",
          "example": "e2e-admin",
          "type": "string"
        },
        "role": {
          "description": "角色，如 admin、tester",
          "example": "admin",
          "type": "string"
        },
        "username": {
          "description": "登录用户名",
          "example": "admin",
          "type": "string"
        }
      },
      "required": [
        "id",
        "username",
        "role"
      ],
      "type": "object"
    },
    "CreateUserRequest": {
      "properties": {
        "active": {
          "description": "是否启用，留空默认为 true",
          "example": true,
          "type": "boolean"
        },
        "email": {
          "description": "用户邮箱，必填，须包含 @",
          "example": "charlie@example.test",
          "type": "string"
        },
        "name": {
          "description": "用户姓名，必填",
          "example": "Charlie",
          "type": "string"
        },
        "role": {
          "description": "用户角色，留空默认为 tester",
          "example": "tester",
          "type": "string"
        }
      },
      "required": [
        "name",
        "email"
      ],
      "type": "object"
    },
    "ErrorResponse": {
      "properties": {
        "error": {
          "description": "错误描述信息",
          "example": "user not found",
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "HealthResponse": {
      "properties": {
        "status": {
          "description": "服务状态，正常时为 ok",
          "example": "ok",
          "type": "string"
        }
      },
      "type": "object"
    },
    "LoginRequest": {
      "properties": {
        "password": {
          "description": "登录密码",
          "example": "admin123",
          "type": "string"
        },
        "username": {
          "description": "登录用户名",
          "example": "admin",
          "type": "string"
        }
      },
      "required": [
        "username",
        "password"
      ],
      "type": "object"
    },
    "LoginResponse": {
      "properties": {
        "token": {
          "description": "JWT Bearer Token，请求时放入 Authorization 头",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "type": "string"
        },
        "user": {
          "$ref": "#/definitions/AuthUser"
        }
      },
      "required": [
        "token",
        "user"
      ],
      "type": "object"
    },
    "UpdateUserRequest": {
      "properties": {
        "active": {
          "description": "是否启用，留空则不更新",
          "example": true,
          "type": "boolean"
        },
        "email": {
          "description": "用户邮箱，留空则不更新",
          "example": "charlie.updated@example.test",
          "type": "string"
        },
        "name": {
          "description": "用户姓名，留空则不更新",
          "example": "Charlie Updated",
          "type": "string"
        },
        "role": {
          "description": "用户角色，留空则不更新",
          "example": "admin",
          "type": "string"
        }
      },
      "type": "object"
    },
    "User": {
      "properties": {
        "active": {
          "description": "是否启用",
          "example": true,
          "type": "boolean"
        },
        "createdAt": {
          "description": "创建时间",
          "example": "2026-01-01T00:00:00Z",
          "format": "date-time",
          "type": "string"
        },
        "email": {
          "description": "用户邮箱",
          "example": "alice@example.test",
          "type": "string"
        },
        "id": {
          "description": "用户唯一标识（UUID）",
          "example": "1",
          "type": "string"
        },
        "name": {
          "description": "用户姓名",
          "example": "Alice",
          "type": "string"
        },
        "role": {
          "description": "用户角色，如 admin、tester",
          "example": "tester",
          "type": "string"
        },
        "updatedAt": {
          "description": "最后更新时间",
          "example": "2026-01-01T00:00:00Z",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "role",
        "active",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    }
  },
  "host": "localhost:18080",
  "info": {
    "description": "供自动化测试平台导入与执行的本地被测服务。",
    "title": "自动化测试平台 E2E 示例 API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/admin/audit-logs": {
      "get": {
        "operationId": "adminAuditLogs",
        "responses": {
          "200": {
            "description": "审计日志列表",
            "schema": {
              "items": {
                "$ref": "#/definitions/AuditLog"
              },
              "type": "array"
            }
          },
          "401": {
            "description": "未授权，token 无效或已过期",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "security": [
          {
            "AdminBearerAuth": []
          }
        ],
        "summary": "获取审计日志列表",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/auth/login": {
      "post": {
        "operationId": "adminLogin",
        "parameters": [
          {
            "description": "管理员登录凭据",
            "in": "body",
            "name": "credentials",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AdminLoginRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "登录成功，返回 token 与管理员信息",
            "schema": {
              "$ref": "#/definitions/LoginResponse"
            }
          },
          "400": {
            "description": "请求参数错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "用户名或密码错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "summary": "管理员登录获取 JWT",
        "tags": [
          "admin-auth"
        ]
      }
    },
    "/api/v1/admin/stats": {
      "get": {
        "operationId": "adminStats",
        "responses": {
          "200": {
            "description": "平台统计数据",
            "schema": {
              "$ref": "#/definitions/AdminStats"
            }
          },
          "401": {
            "description": "未授权，token 无效或已过期",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "security": [
          {
            "AdminBearerAuth": []
          }
        ],
        "summary": "获取平台统计数据",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/users": {
      "get": {
        "operationId": "adminListUsers",
        "parameters": [
          {
            "description": "按角色筛选，留空返回全部",
            "in": "query",
            "name": "role",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "用户列表及总数",
            "schema": {
              "$ref": "#/definitions/AdminUserListResponse"
            }
          },
          "401": {
            "description": "未授权，token 无效或已过期",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "security": [
          {
            "AdminBearerAuth": []
          }
        ],
        "summary": "管理员获取用户列表",
        "tags": [
          "admin-users"
        ]
      },
      "post": {
        "operationId": "adminCreateUser",
        "parameters": [
          {
            "description": "新建用户请求体",
            "in": "body",
            "name": "user",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateUserRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "新建成功，返回用户详情",
            "schema": {
              "$ref": "#/definitions/User"
            }
          },
          "400": {
            "description": "参数校验失败",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "未授权，token 无效或已过期",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "security": [
          {
            "AdminBearerAuth": []
          }
        ],
        "summary": "管理员新建用户",
        "tags": [
          "admin-users"
        ]
      }
    },
    "/api/v1/admin/users/{id}": {
      "delete": {
        "operationId": "adminDeleteUser",
        "parameters": [
          {
            "description": "用户 ID（UUID）",
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "204": {
            "description": "删除成功"
          },
          "401": {
            "description": "未授权，token 无效或已过期",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "用户不存在",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "security": [
          {
            "AdminBearerAuth": []
          }
        ],
        "summary": "管理员删除用户",
        "tags": [
          "admin-users"
        ]
      },
      "get": {
        "operationId": "adminGetUser",
        "parameters": [
          {
            "description": "用户 ID（UUID）",
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "用户详情",
            "schema": {
              "$ref": "#/definitions/User"
            }
          },
          "401": {
            "description": "未授权，token 无效或已过期",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "用户不存在",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "security": [
          {
            "AdminBearerAuth": []
          }
        ],
        "summary": "管理员根据 ID 获取用户详情",
        "tags": [
          "admin-users"
        ]
      },
      "put": {
        "operationId": "adminUpdateUser",
        "parameters": [
          {
            "description": "用户 ID（UUID）",
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "description": "待更新的用户字段",
            "in": "body",
            "name": "user",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateUserRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "更新成功，返回最新用户详情",
            "schema": {
              "$ref": "#/definitions/User"
            }
          },
          "400": {
            "description": "参数校验失败",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "未授权，token 无效或已过期",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "用户不存在",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "security": [
          {
            "AdminBearerAuth": []
          }
        ],
        "summary": "管理员更新用户信息",
        "tags": [
          "admin-users"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "parameters": [
          {
            "description": "登录凭据",
            "in": "body",
            "name": "credentials",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LoginRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "登录成功，返回 token 与用户信息",
            "schema": {
              "$ref": "#/definitions/LoginResponse"
            }
          },
          "400": {
            "description": "请求参数错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "401": {
            "description": "用户名或密码错误",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "summary": "用户登录获取 JWT",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "当前登录用户",
            "schema": {
              "$ref": "#/definitions/AuthUser"
            }
          },
          "401": {
            "description": "未授权，token 无效或已过期",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "获取当前登录用户信息",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/users": {
      "get": {
        "operationId": "listUsers",
        "parameters": [
          {
            "description": "按角色筛选，留空返回全部",
            "in": "query",
            "name": "role",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "用户列表",
            "schema": {
              "items": {
                "$ref": "#/definitions/User"
              },
              "type": "array"
            }
          },
          "401": {
            "description": "未授权，token 无效或已过期",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "获取用户列表",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "operationId": "getUser",
        "parameters": [
          {
            "description": "用户 ID（UUID）",
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "用户详情",
            "schema": {
              "$ref": "#/definitions/User"
            }
          },
          "401": {
            "description": "未授权，token 无效或已过期",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "用户不存在",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "根据 ID 获取用户详情",
        "tags": [
          "users"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "服务正常",
            "schema": {
              "$ref": "#/definitions/HealthResponse"
            }
          }
        },
        "summary": "健康检查",
        "tags": [
          "health"
        ]
      }
    }
  },
  "produces": [
    "application/json"
  ],
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "AdminBearerAuth": {
      "description": "使用 /api/v1/admin/auth/login 返回的 token，格式：Bearer \u003ctoken\u003e",
      "in": "header",
      "name": "Authorization",
      "type": "apiKey"
    },
    "BearerAuth": {
      "description": "使用 /api/v1/auth/login 返回的 token，格式：Bearer \u003ctoken\u003e",
      "in": "header",
      "name": "Authorization",
      "type": "apiKey"
    }
  },
  "swagger": "2.0",
  "tags": [
    {
      "description": "服务健康检查",
      "name": "health"
    },
    {
      "description": "用户 JWT 认证",
      "name": "auth"
    },
    {
      "description": "用户只读操作（列表、详情、当前用户信息）",
      "name": "users"
    },
    {
      "description": "管理员 JWT 认证",
      "name": "admin-auth"
    },
    {
      "description": "管理员用户管理（完整 CRUD）",
      "name": "admin-users"
    },
    {
      "description": "管理员统计与审计日志",
      "name": "admin"
    }
  ]
}