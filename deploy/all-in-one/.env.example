# 可选一体栈（非默认生产方案）：复制为 .env 后执行 make all-in-one-up
# 访问 http://localhost:8080，默认账号 admin / admin（首次登录须改密）
# 生产部署见 docs/design/architecture.md#生产部署

APP_ENV=development

# PostgreSQL 托管方式（Makefile / docker compose 工具变量，不进 Go 运行时）
# docker：compose 内 postgres（默认，适合快速试用）
# external：仅启动 API，POSTGRES_HOST 指向外部库（容器内需能访问，例如 host.docker.internal）
DB_MANAGED=docker

POSTGRES_USER=autotest
POSTGRES_PASSWORD=autotest
POSTGRES_DB=autotest
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

JWT_SECRET=autotest-dev-secret-change-me

# 可信前端域名可在管理后台「用户管理 → 登录方式」配置；development 内置 localhost 默认项
