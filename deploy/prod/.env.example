# 自托管服务器生产环境（Firebase 前端 + Docker Compose 后端）
# 复制为项目根目录 .env 后，用 docker compose 启动（见 docs/design/architecture.md#生产部署）

APP_ENV=production

# PostgreSQL 托管方式（Makefile / docker compose 工具变量，不进 Go 运行时）
# docker：compose 内 postgres，POSTGRES_HOST 写 localhost（脚本在 compose 内改写为 postgres）
# external：仅启动 API，POSTGRES_HOST 指向外部库（容器内需能访问，例如 host.docker.internal）
DB_MANAGED=external

# 数据库（POSTGRES_* 同时用于 bundled-db 的 postgres 容器初始化）
POSTGRES_USER=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=REPLACE_ME
POSTGRES_HOST=REPLACE_ME
POSTGRES_PORT=REPLACE_ME
POSTGRES_SSLMODE=disable

# API
JWT_SECRET=REPLACE_ME

# 前后端分离：浏览器跨域 CORS 白名单（Firebase 等前端 Origin，与登录方式「可信前端域名」无关）
CORS_ALLOWED_ORIGINS=https://autotest-one.web.app,https://autotest.jiangyang.online
# OAuth 登录方式（GitHub / GitLab / Google）在管理后台「用户管理 → 登录方式」配置
# 各登录方式的「可信前端域名」仅用于 OAuth 回跳 frontendUrl 校验
# 前端构建时设置 VITE_API_BASE_URL（见 web/admin/.env.production.example），保存登录方式时回调 URL 写入 DB

LOG_LEVEL=info
LOG_FORMAT=json
