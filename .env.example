# === App ===
# development | test | staging | production
APP_ENV=development
ADDR=:8080

# === Database ===
POSTGRES_USER=autotest
POSTGRES_PASSWORD=autotest
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autotest
POSTGRES_SSLMODE=disable

# === Makefile 工具（不进 Go 运行时）===
# docker：make up / make all-in-one-up 或生产 compose 启动 compose 内 postgres（host 仍写 localhost，脚本会改写为 postgres）
# external：不启动 compose 内 postgres
DB_MANAGED=external

# === Secrets ===
# 默认管理员 admin/admin 写死在代码中，首次登录须改密；production 仍会校验 JWT_SECRET 不得为默认值
JWT_SECRET=autotest-dev-secret-change-me

# === OAuth / 前端 ===
# 登录方式「可信前端域名」：仅 OAuth 回跳 frontendUrl 校验（管理后台配置）
# CORS 白名单：前后端分离时在 API 环境变量配置（与可信前端域名独立）
# CORS_ALLOWED_ORIGINS=https://your-app.web.app
# OAuth 回调 URL 由管理端根据 VITE_API_BASE_URL + slug 生成并持久化（见 web/admin/.env.production.example）

# === MCP (cmd/mcp, Cursor / Claude Desktop) ===
# AUTOTEST_API_BASE_URL=http://localhost:8080/api/v1
# AUTOTEST_API_KEY=at-your-key-with-specs-import
# AUTOTEST_PROJECT_ID=
# AUTOTEST_SERVICE_ID=

# === Logging ===
# 未设置时按 APP_ENV 默认：development→debug/text，production→info/json
LOG_LEVEL=debug
LOG_FORMAT=text

# === AI 助理运行时（推荐在后台「平台资源 → AI 能力管理 → AI 助理配置」维护）===
# 以下为未入库时的环境变量默认值；保存后台配置后以数据库为准。
# AI_MAX_TOOL_HOPS=6
# AI_TOOL_ROUTING_MODE=shadow
# AI_SCENARIO_AUTORUN=off
# AI_SCENARIO_GEN_MAX_ROUNDS=3
# AI_ROUTER_CONFIDENCE_THRESHOLD=0.7

# === AI find_tools 向量检索（可选）===
# 预计算工具向量：make gen-tool-embeddings（写入 internal/aitools/data/tool_embeddings.json）
# 运行时查询向量：未配置时尝试复用 OpenAI 兼容对话 Provider 的 /embeddings
# AI_TOOL_EMBED_BASE_URL=https://api.openai.com/v1
# AI_TOOL_EMBED_API_KEY=
# AI_TOOL_EMBED_MODEL=text-embedding-3-small

# === Docker ===
API_PORT=8080
AUTOTEST_IMAGE=autotest:latest
